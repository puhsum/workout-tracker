[Unit]
Description=Workout Tracker Telegram Bot
After=network.target

[Service]
Type=simple
User=gabe
WorkingDirectory=/home/gabe/workout-tracker/bot
ExecStart=/home/gabe/workout-tracker/bot/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
